# Managed by chezmoi. Edit the source at ~/Documents/dotfiles/dot_bashrc
# (do not edit this file directly).
#
# If zsh is installed, replace this bash shell with a zsh login shell.
# This lets hosts where the login shell is bash (e.g. some servers where you
# can't chsh without root) still drop into the managed zsh setup on login.
#
# Only exec for interactive shells: non-interactive bash (scp, rsync, git over
# ssh, ansible, etc.) must keep running bash or they break (scp in particular
# fails if the shell prints anything before the transfer). The tty check keeps
# interactive-but-piped bash (e.g. `ssh host 'bash -i'` with pipes on stdin and
# stdout) from being taken over, which would make zsh consume the piped input.
case $- in
    *i*) : ;;
    *) return ;;
esac
if [[ -t 0 && -t 1 ]] && [ -x "$(command -v zsh)" ] && [ -z "${ZSH_VERSION:-}" ]; then
    export SHELL="$(command -v zsh)"
    exec zsh -l
fi

# Host-specific config (secrets, account vars, etc.) lives in ~/.bashrc.local,
# mirroring ~/.zshrc.local, so it survives chezmoi apply.
[[ -f ~/.bashrc.local ]] && source ~/.bashrc.local
