{{/* gpgKey is a newer data key; guard with hasKey so hosts whose
     chezmoi.toml predates it don't error on apply. */}}
{{- $gpgKey := "" -}}
{{- if hasKey . "gpgKey" }}{{- $gpgKey = .gpgKey -}}{{- end }}
{{- /* checkout.workers=16, alias.lb and safe.directory match what the
       clusters' /etc/shell-config/shell-config.sh enforces on every shell;
       keeping them identical avoids perpetual chezmoi diffs. */}}
[user]
    name = {{ .name }}
    email = {{ .email }}
{{- if $gpgKey }}
    signingkey = {{ $gpgKey | quote }}
{{- end }}

# Local/private config goes in the include
[include]
    path = ~/.gitconfig.local
{{- if $gpgKey }}

# Sign commits and tags with an SSH key (gpg.format = ssh).
# The key is configured above via user.signingkey; set the gpgKey data
# value to blank to disable signing entirely.
[gpg]
    format = ssh

[commit]
    gpgsign = true

[tag]
    gpgsign = true
{{- end }}

[core]
    pager = delta
    untrackedCache = true
    checkstat = minimal

[checkout]
    workers = 16

[init]
    defaultBranch = main

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection
    line-numbers = true
    side-by-side = true
    file-modified-label = modified:
[merge]
    conflictstyle = zdiff3

[pull]
    rebase = true

[alias]
    fix-commit = "!f() { pre-commit run && git add . && git commit -m \"$@\"; }; f"
    lb = for-each-ref --sort=committerdate refs/heads/ --format=\"%(refname:short) %(committerdate:relative)\"

[fetch]
	prune = true
[rebase]
	autosquash = true
[safe]
    directory = /mnt/vast/shared/registry
